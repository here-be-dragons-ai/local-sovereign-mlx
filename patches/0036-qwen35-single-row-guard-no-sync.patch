+def _single_row_started(cache_entry) -> bool:
+    """`offset[0] >= 0` for a one-row batch cache, without a device sync.
+
+    Local patch 0036. `int(offset[0].item())` runs once per decode step; the
+    offset is advanced lazily every step, so `.item()` waits for the previous
+    step's whole forward and stalls the decode pipeline (measured: warm decode
+    -4.5% at 28k tokens without a drafter). BatchKVCache keeps
+    `offset == _idx - left_padding`, with `_idx` a Python int and
+    `left_padding` an array that changes only on prepare/filter/finalize, so
+    reading it does not wait on the step in flight.
+    """
+    idx = getattr(cache_entry, "_idx", None)
+    if type(cache_entry) is BatchKVCache and isinstance(idx, int):
+        return idx >= cache_entry.left_padding.tolist()[0]
+    return int(cache_entry.offset[0].item()) >= 0
+
